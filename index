                        >
                          <Paperclip className="w-5 h-5" />
                        </button>

                        {isRecordingVoice ? (
                          <div className="flex-1 bg-zinc-900 border border-white/40 rounded-xl px-4 py-2.5 flex items-center justify-between">
                            <div className="flex items-center gap-2 text-xs text-white font-medium">
                              <span className="w-2.5 h-2.5 rounded-full bg-white animate-ping" />
                              <span>Recording Voice... {recordingSeconds}s</span>
                            </div>
                            <div className="flex items-center gap-2">
                              <button
                                type="button"
                                onClick={() => setIsRecordingVoice(false)}
                                className="text-xs text-zinc-400 hover:text-white px-2"
                              >
                                Cancel
                              </button>
                              <button
                                type="button"
                                onClick={handleFinishVoiceNote}
                                className="px-3 py-1 rounded-lg bg-white text-black font-bold text-xs cursor-pointer"
                              >
                                Send Voice
                              </button>
                            </div>
                          </div>
                        ) : (
                          <input
                            type="text"
                            value={inputText}
                            onChange={(e) => setInputText(e.target.value)}
                            placeholder={`Message ${getConversationDisplayName(activeConversation)}...`}
                            className="flex-1 bg-black border border-zinc-800 focus:border-white rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none"
                          />
                        )}

                        {!isRecordingVoice && !inputText.trim() ? (
                          <button
                            type="button"
                            onClick={() => setIsRecordingVoice(true)}
                            title="Record Voice Note"
                            className="p-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white transition cursor-pointer"
                          >
                            <Mic className="w-5 h-5" />
                          </button>
                        ) : (
                          !isRecordingVoice && (
                            <button
                              type="submit"
                              className="px-4 py-2.5 rounded-xl bg-white hover:bg-zinc-200 text-black font-bold text-xs flex items-center gap-1.5 transition cursor-pointer"
                            >
                              <Send className="w-4 h-4" />
                              <span className="hidden sm:inline">Send</span>
                            </button>
                          )
                        )}
                      </form>
                    </div>

                    {showContactInfoDrawer && partnerUser && (
                      <div className="w-72 bg-[#080808] border-l border-zinc-900 p-5 flex flex-col justify-between overflow-y-auto shrink-0">
                        <div className="space-y-5">
                          <div className="flex items-center justify-between">
                            <span className="text-xs font-bold uppercase tracking-wider text-zinc-400">Contact Info</span>
                            <button onClick={() => setShowContactInfoDrawer(false)} className="text-zinc-500 hover:text-white">
                              <X className="w-4 h-4" />
                            </button>
                          </div>

                          <div className="flex flex-col items-center text-center">
                            <div className="w-20 h-20 rounded-full bg-white text-black font-bold text-2xl flex items-center justify-center mb-3">
                              {partnerUser.alias.charAt(0)}
                            </div>
                            <h3 className="text-base font-bold text-white">{partnerUser.alias}</h3>
                            <p className="text-xs text-zinc-400 mt-1">{partnerUser.bio}</p>
                            <span className="mt-2 px-2.5 py-1 rounded-lg bg-black border border-zinc-800 font-mono text-[11px] text-white">
                              {partnerUser.whisperCode}
                            </span>
                          </div>

                          <div className="space-y-2">
                            <button
                              onClick={() => handleToggleBlockPartner(partnerUser.whisperCode)}
                              className="w-full py-2.5 rounded-xl bg-red-950/40 border border-red-900/60 text-red-300 font-semibold text-xs flex items-center justify-center gap-2 cursor-pointer"
                            >
                              <Ban className="w-4 h-4" />
                              <span>{currentUser.blockedCodes?.includes(partnerUser.whisperCode) ? 'Unblock Contact' : 'Block Contact'}</span>
                            </button>
                          </div>
                        </div>

                        <div className="pt-4 border-t border-zinc-900 text-center">
                          <WhisperLogo className="w-8 h-8 mx-auto mb-1 opacity-80" />
                          <span className="text-[10px] font-mono text-zinc-500">WHISPER E2EE</span>
                        </div>
                      </div>
                    )}
                  </div>
                </>
              ) : null}
            </main>
          </div>
        )}
      </div>

      {/* MODAL: FORWARD MESSAGE */}
      {showForwardModal && (
        <div className="fixed inset-0 z-60 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="w-full max-w-md bg-[#0a0a0a] border border-zinc-800 rounded-3xl p-6 shadow-2xl">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-base font-bold text-white">Forward Message to...</h3>
              <button onClick={() => setShowForwardModal(false)} className="text-zinc-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>
            <p className="text-xs text-zinc-400 mb-3">Select a conversation:</p>
            <div className="space-y-2 max-h-64 overflow-y-auto">
              {conversations.map((c) => (
                <button
                  key={c.id}
                  onClick={() => handleForwardMessageToConv(c.id)}
                  className="w-full p-3 rounded-2xl bg-black hover:bg-zinc-900 border border-zinc-800 flex items-center justify-between text-left transition cursor-pointer"
                >
                  <span className="text-sm font-bold text-white">{getConversationDisplayName(c)}</span>
                  <span className="px-3 py-1 rounded-lg bg-white text-black font-bold text-xs">Forward</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* MODAL: START NEW CHAT */}
      {showNewChatModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="w-full max-w-md bg-[#0a0a0a] border border-zinc-800 rounded-3xl p-6 shadow-2xl">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-base font-bold text-white">Start New Chat</h3>
              <button onClick={() => setShowNewChatModal(false)} className="text-zinc-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>
            <p className="text-xs text-zinc-400 mb-4">Select from your added clients:</p>
            <div className="space-y-2 max-h-72 overflow-y-auto">
              {visibleContacts.map((u) => (
                <button
                  key={u.id}
                  onClick={() => startOrOpenDirectChat(u)}
                  className="w-full p-3 rounded-2xl bg-black hover:bg-zinc-900 border border-zinc-800 flex items-center justify-between text-left transition cursor-pointer"
                >
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-full bg-white text-black font-bold text-sm flex items-center justify-center">
                      {u.alias.charAt(0)}
                    </div>
                    <div>
                      <div className="text-sm font-bold text-white">{u.alias}</div>
                      <div className="text-[11px] font-mono text-zinc-400">{u.whisperCode}</div>
                    </div>
                  </div>
                  <span className="px-3 py-1.5 rounded-xl bg-white text-black font-bold text-xs">Chat</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* MODAL: ADD CLIENT BY WHISPER-CODE */}
      {showAddClientByCodeModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="w-full max-w-md bg-[#0a0a0a] border border-zinc-800 rounded-3xl p-6 shadow-2xl">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-base font-bold text-white">Add Client by Whisper-Code</h3>
              <button onClick={() => setShowAddClientByCodeModal(false)} className="text-zinc-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>
            <p className="text-xs text-zinc-400 mb-4">
              Enter the exact Whisper-Code shared by your client (e.g. <code className="text-white">WSP-8821-VORTEX</code>):
            </p>
            <form onSubmit={handleAddClientByCode} className="space-y-4">
              <input
                type="text"
                required
                value={addCodeInput}
                onChange={(e) => setAddCodeInput(e.target.value)}
                placeholder="WSP-XXXX-CODE"
                className="w-full bg-black border border-zinc-800 focus:border-white rounded-xl px-4 py-3 text-sm font-mono tracking-wider text-white"
              />
              <button
                type="submit"
                className="w-full py-3 rounded-xl bg-white text-black font-bold text-xs uppercase cursor-pointer"
              >
                Add Client to My Network
              </button>
            </form>
          </div>
        </div>
      )}

      {/* MODAL: CREATE GROUP */}
      {showNewGroupModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="w-full max-w-md bg-[#0a0a0a] border border-zinc-800 rounded-3xl p-6">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-base font-bold text-white">New Encrypted Group</h3>
              <button onClick={() => setShowNewGroupModal(false)} className="text-zinc-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleCreateGroup} className="space-y-4">
              <div>
                <label className="block text-xs text-zinc-300 mb-1">Group Name</label>
                <input
                  type="text"
                  required
                  value={newGroupName}
                  onChange={(e) => setNewGroupName(e.target.value)}
                  placeholder="e.g. Executive Circle"
                  className="w-full bg-black border border-zinc-800 focus:border-white rounded-xl px-3.5 py-2.5 text-sm text-white"
                />
              </div>

              <div>
                <label className="block text-xs text-zinc-300 mb-2">Select Members</label>
                <div className="space-y-1.5 max-h-48 overflow-y-auto">
                  {visibleContacts.map((u) => {
                    const checked = selectedGroupMembers.includes(u.whisperCode);
                    return (
                      <button
                        key={u.id}
                        type="button"
                        onClick={() =>
                          setSelectedGroupMembers((prev) =>
                            checked ? prev.filter((c) => c !== u.whisperCode) : [...prev, u.whisperCode]
                          )
                        }
                        className={`w-full p-2.5 rounded-xl border text-left flex items-center justify-between text-xs cursor-pointer ${
                          checked ? 'bg-white text-black font-bold border-white' : 'bg-black border-zinc-800 text-zinc-300'
                        }`}
                      >
                        <span>{u.alias} ({u.whisperCode})</span>
                        {checked && <Check className="w-4 h-4" />}
                      </button>
                    );
                  })}
                </div>
              </div>

              <button
                type="submit"
                className="w-full py-3 rounded-xl bg-white hover:bg-zinc-200 text-black font-bold text-xs uppercase tracking-wider cursor-pointer"
              >
                Create Group
              </button>
            </form>
          </div>
        </div>
      )}

      {/* SAFETY NUMBER MODAL */}
      {showSafetyModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="w-full max-w-md bg-[#0a0a0a] border border-zinc-800 rounded-3xl p-6 text-center">
            <WhisperLogo className="w-14 h-14 mx-auto mb-3" />
            <h3 className="text-base font-bold text-white">E2EE Safety Number</h3>
            <p className="text-xs text-zinc-400 mt-1">Verify this fingerprint with your client.</p>
            <div className="my-5 p-4 rounded-2xl bg-black border border-zinc-800 font-mono text-sm tracking-widest text-white grid grid-cols-3 gap-2">
              <span>48291</span><span>00942</span><span>88412</span>
              <span>77310</span><span>55921</span><span>31094</span>
            </div>
            <button
              onClick={() => setShowSafetyModal(false)}
              className="w-full py-3 rounded-xl bg-white text-black font-bold text-xs uppercase cursor-pointer"
            >
              Done
            </button>
          </div>
        </div>
      )}

      {/* MODAL: ADD PARTICIPANT TO ONGOING CALL */}
      {showAddParticipantModal && (
        <div className="fixed inset-0 z-60 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="w-full max-w-md bg-[#0a0a0a] border border-zinc-800 rounded-3xl p-6 shadow-2xl">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-base font-bold text-white">Add User to Ongoing Call</h3>
              <button onClick={() => setShowAddParticipantModal(false)} className="text-zinc-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>
            <div className="space-y-2 max-h-64 overflow-y-auto">
              {visibleContacts.map((u) => (
                <button
                  key={u.id}
                  onClick={() => addParticipantToCall(u)}
                  className="w-full p-3 rounded-2xl bg-black hover:bg-zinc-900 border border-zinc-800 flex items-center justify-between text-left transition cursor-pointer"
                >
                  <span className="font-bold text-sm text-white">{u.alias}</span>
                  <span className="px-3 py-1 rounded-lg bg-white text-black font-bold text-xs">+ Add</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* CALL OVERLAY (WITH MINIMIZER & AUDIO ROUTING) */}
      {callState.active && (
        <div
          className={`fixed z-50 bg-black flex flex-col justify-between transition-all duration-300 ${
            callState.minimized
              ? 'bottom-4 right-4 w-80 h-44 rounded-2xl border border-zinc-700 shadow-2xl p-3'
              : 'inset-0 p-6'
          }`}
        >
          {callState.minimized ? (
            <div className="flex flex-col justify-between h-full">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <span className="w-2.5 h-2.5 rounded-full bg-white animate-ping" />
                  <span className="text-xs font-bold text-white truncate">{callState.convName}</span>
                </div>
                <div className="flex items-center gap-1.5">
                  <button
                    onClick={() => setCallState((prev) => ({ ...prev, minimized: false }))}
                    className="p-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-white cursor-pointer"
                    title="Maximize Call"
                  >
                    <ArrowRight className="w-3.5 h-3.5 rotate-[-45deg]" />
                  </button>
                  <button
                    onClick={endCall}
                    className="p-1.5 rounded-lg bg-red-950 text-red-300 hover:bg-red-900 cursor-pointer"
                    title="End Call"
                  >
                    <PhoneOff className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>
              <div className="text-center font-mono text-xs text-zinc-400">
                {formatDuration(callState.duration)} • E2EE {callState.type.toUpperCase()}
              </div>
              <div className="flex justify-center gap-2">
                <button
                  onClick={() => setCallState((prev) => ({ ...prev, isMuted: !prev.isMuted }))}
                  className={`p-2 rounded-xl text-xs font-bold ${callState.isMuted ? 'bg-white text-black' : 'bg-zinc-900 text-white'}`}
                >
                  {callState.isMuted ? 'Muted' : 'Mute'}
                </button>
                <button
                  onClick={handleToggleAudioOutput}
                  className="p-2 rounded-xl bg-zinc-900 text-white text-xs font-bold capitalize"
                >
                  {callState.audioOutput}
                </button>
              </div>
            </div>
          ) : (
            <>
              <div className="flex items-center justify-between border-b border-zinc-900 pb-4">
                <div className="flex items-center gap-3">
                  <WhisperLogo className="w-10 h-10" />
                  <div>
                    <div className="text-base font-bold text-white flex items-center gap-2">
                      <span>{callState.convName} ({callState.participants.length} on call)</span>
                      <span className="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-white text-black font-bold">
                        E2EE {callState.type.toUpperCase()}
                      </span>
                    </div>
                    <div className="text-xs font-mono text-zinc-400">{formatDuration(callState.duration)} • Encrypted Stream</div>
                  </div>
                </div>

                <div className="flex items-center gap-3">
                  <button
                    onClick={() => setCallState((prev) => ({ ...prev, minimized: true }))}
                    className="px-3 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-white text-xs font-bold flex items-center gap-1.5 cursor-pointer"
                    title="Minimize call to floating widget"
                  >
                    <ChevronLeft className="w-4 h-4 rotate-[-90deg]" />
                    <span>Minimize</span>
                  </button>
                  <button
                    onClick={() => setShowAddParticipantModal(true)}
                    className="px-3 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-white text-xs font-bold flex items-center gap-1.5 cursor-pointer"
                  >
                    <UserPlus className="w-4 h-4" />
                    <span>Add User</span>
                  </button>
                  <div className="bg-zinc-950 border border-zinc-800 rounded-2xl px-4 py-2 text-right hidden sm:block">
                    <div className="text-[10px] font-mono uppercase text-zinc-500">Key Verification</div>
                    <div className="text-sm tracking-widest mt-0.5">{callState.verifyEmoji}</div>
                  </div>
                </div>
              </div>

              {/* Multi-User Grid Conferencing */}
              <div className="flex-1 my-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl w-full mx-auto overflow-y-auto">
                {callState.participants.map((p, idx) => (
                  <div
                    key={idx}
                    className="rounded-3xl bg-[#090909] border border-zinc-800 flex flex-col items-center justify-center relative p-6 aspect-video sm:aspect-auto overflow-hidden"
                  >
                    {callState.type === 'video' && p.isSelf && !callState.isCameraOff && !callState.localStreamError ? (
                      <video
                        ref={localVideoRef}
                        autoPlay
                        playsInline
                        muted
                        className="absolute inset-w-full inset-h-full w-full h-full object-cover"
                      />
                    ) : (
                      <>
                        <div className="w-16 h-16 rounded-full bg-white text-black font-bold text-xl flex items-center justify-center mb-3 shadow-xl z-10">
                          {p.name.charAt(0)}
                        </div>
                        <div className="text-sm font-bold text-white z-10">{p.name} {p.isSelf && '(You)'}</div>
                        <div className="text-[11px] text-zinc-400 mt-1 z-10">Connected • Secured</div>
                      </>
                    )}
                  </div>
                ))}
              </div>

              <div className="flex flex-wrap items-center justify-center gap-3">
                <button
                  onClick={() => setCallState((prev) => ({ ...prev, isMuted: !prev.isMuted }))}
                  className={`p-4 rounded-2xl border transition cursor-pointer ${
                    callState.isMuted ? 'bg-white text-black border-white' : 'bg-zinc-900 border-zinc-800 text-white'
                  }`}
                >
                  {callState.isMuted ? <MicOff className="w-5 h-5" /> : <Mic className="w-5 h-5" />}
                </button>

                {callState.type === 'video' && (
                  <>
                    <button
                      onClick={() => setCallState((prev) => ({ ...prev, isCameraOff: !prev.isCameraOff }))}
                      className={`p-4 rounded-2xl border transition cursor-pointer ${
                        callState.isCameraOff ? 'bg-zinc-950 border-zinc-800 text-zinc-500' : 'bg-zinc-900 border-zinc-800 text-white'
                      }`}
                    >
                      {callState.isCameraOff ? <VideoOff className="w-5 h-5" /> : <Video className="w-5 h-5" />}
                    </button>

                    <button
                      onClick={handleToggleCameraFacing}
                      title="Switch Front / Back Camera"
                      className="p-4 rounded-2xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-white transition cursor-pointer"
                    >
                      <Camera className="w-5 h-5" />
                    </button>
                  </>
                )}

                <button
                  onClick={handleToggleAudioOutput}
                  title="Switch Audio Output (Speaker / Earpiece / Headphones)"
                  className="px-4 py-4 rounded-2xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-white transition cursor-pointer flex items-center gap-2 text-xs font-bold capitalize"
                >
                  <Volume2 className="w-4 h-4" />
                  <span>Audio: {callState.audioOutput}</span>
                </button>

                <button
                  onClick={endCall}
                  className="px-8 py-4 rounded-2xl bg-white hover:bg-zinc-200 text-black font-bold text-sm flex items-center gap-2 cursor-pointer"
                >
                  <PhoneOff className="w-5 h-5" />
                  <span>End Call</span>
                </button>
              </div>
            </>
          )}
        </div>
      )}
    </div>
  );
}


