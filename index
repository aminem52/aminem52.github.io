    setCallState((prev) => ({
      ...prev,
      participants: [...prev.participants, { name: userObj.alias, isSelf: false }]
    }));
    setShowAddParticipantModal(false);
    triggerToast(`Added ${userObj.alias} to the encrypted call!`);
  };

  const endCall = () => {
    if (localStreamRef.current) {
      localStreamRef.current.getTracks().forEach((t) => t.stop());
      localStreamRef.current = null;
    }
    setCallState((prev) => ({ ...prev, active: false, minimized: false, duration: 0 }));
    triggerToast('Encrypted call ended.');
