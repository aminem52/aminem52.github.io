  // Call Handlers with Minimizer & Headphone Support
  const startCall = async (callType, customTitle = null) => {
    const title = customTitle || getConversationDisplayName(activeConversation) || 'Private Call';
    const initialParticipants = [
      { name: currentUser.alias, isSelf: true },
      { name: title, isSelf: false }
    ];

    setCallState({
      active: true,
      minimized: false,
      type: callType,
      convName: title,
      duration: 0,
      isMuted: false,
      isCameraOff: callType === 'voice',
      facingMode: 'user',
      audioOutput: 'speaker', // 'speaker' | 'earpiece' | 'headphones'
      verifyEmoji: '🔒 👁️ 👂 ⚡',
      participants: initialParticipants,
      localStreamError: false
    });

    setCallHistory((prev) => [
      {
        id: 'c_' + Date.now(),
        name: title,
        code: activeConversation?.partnerCode || 'GROUP-E2EE',
        type: callType,
        time: 'Just now',
        duration: 'Active',
        status: 'End-to-End Encrypted'
      },
      ...prev
    ]);

    if (callType === 'video') {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user' },
          audio: true
        });
        localStreamRef.current = stream;
        if (localVideoRef.current) {
          localVideoRef.current.srcObject = stream;
        }
      } catch {
        setCallState((prev) => ({ ...prev, localStreamError: true }));
      }
    }
  };

  const handleToggleCameraFacing = async () => {
    const nextFacing = callState.facingMode === 'user' ? 'environment' : 'user';
    setCallState((prev) => ({ ...prev, facingMode: nextFacing }));
    try {
      if (localStreamRef.current) {
        localStreamRef.current.getTracks().forEach((t) => t.stop());
      }
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: nextFacing },
        audio: true
      });
      localStreamRef.current = stream;
      if (localVideoRef.current) {
        localVideoRef.current.srcObject = stream;
      }
      triggerToast(`Camera switched to ${nextFacing === 'user' ? 'Front' : 'Back'}`);
    } catch {
      triggerToast('Could not switch camera stream.');
    }
  };

  const handleToggleAudioOutput = () => {
    // Cycle between speaker -> earpiece -> headphones -> speaker
    const outputs = ['speaker', 'earpiece', 'headphones'];
    const nextOutput = outputs[(outputs.indexOf(callState.audioOutput) + 1) % outputs.length];
    setCallState((prev) => ({ ...prev, audioOutput: nextOutput }));
    const label =
      nextOutput === 'speaker'
        ? 'Loudspeaker'
        : nextOutput === 'earpiece'
        ? 'Earpiece'
        : 'Headphones / Bluetooth';
    triggerToast(`Audio routed to: ${label}`);
  };

  const handleAddParticipantToCall = (userObj) => {
    if (callState.participants.some((p) => p.name === userObj.alias)) {
      triggerToast(`${userObj.alias} is already on the call.`);
      return;
