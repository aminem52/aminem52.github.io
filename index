      conversations[0]
    );
  }, [conversations, activeConvId, visibleConversations]);

  const activeMessages = useMemo(() => {
    if (!activeConversation) return [];
    return messages.filter((m) => m.convId === activeConversation.id);
  }, [messages, activeConversation]);

  const handleToggleBlockPartner = (partnerCode) => {
    if (!currentUser || !partnerCode) return;
    const isBlocked = currentUser.blockedCodes?.includes(partnerCode);
    const updatedBlocked = isBlocked
      ? currentUser.blockedCodes.filter((c) => c !== partnerCode)
      : [...(currentUser.blockedCodes || []), partnerCode];

    setUsers((prev) =>
      prev.map((u) => (u.id === currentUser.id ? { ...u, blockedCodes: updatedBlocked } : u))
    );
    triggerToast(isBlocked ? 'Contact unblocked.' : 'Contact blocked. They cannot reach you on Whisper.');
  };

  const handleDeleteMessage = (msgId) => {
    setMessages((prev) => prev.filter((m) => m.id !== msgId));
    triggerToast('Message deleted.');
  };

  const handleDeleteActiveChat = () => {
    if (!activeConversation) return;
    setConversations((prev) => prev.filter((c) => c.id !== activeConversation.id));
    setMessages((prev) => prev.filter((m) => m.convId !== activeConversation.id));
    setMobileShowChat(false);
    triggerToast('Chat conversation deleted.');
  };

  // Message Forwarding Handler
  const handleForwardMessageToConv = async (targetConvId) => {
    if (!forwardingMessage || !currentUser) return;
    const targetConv = conversations.find((c) => c.id === targetConvId);
    if (!targetConv) return;

    const encryptedPacket = await CryptoEngine.encryptPayload(forwardingMessage.text, targetConv.id);
    const forwardMsg = {
      id: 'm_fwd_' + Date.now(),
      convId: targetConv.id,
      senderCode: currentUser.whisperCode,
      senderAlias: currentUser.alias,
      text: forwardingMessage.text,
      cipherText: encryptedPacket.cipherText,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      status: 'read',
      type: forwardingMessage.type || 'text',
      reactions: [],
      expiresAt: targetConv.disappearingTimer > 0 ? Date.now() + targetConv.disappearingTimer * 1000 : null
    };

    setMessages((prev) => [...prev, forwardMsg]);
    setShowForwardModal(false);
    setForwardingMessage(null);
    triggerToast(`Message forwarded to ${getConversationDisplayName(targetConv)}`);
  };

  const handleSendMessage = async (e) => {
    e?.preventDefault();
    if (!inputText.trim() || !currentUser || !activeConversation) return;

    const plain = inputText.trim();
    setInputText('');
    setShowEmojiPicker(false);
    const currentReply = replyingTo;
    setReplyingTo(null);

    const encryptedPacket = await CryptoEngine.encryptPayload(plain, activeConversation.id);
    const expiryTime =
      activeConversation.disappearingTimer > 0
        ? Date.now() + activeConversation.disappearingTimer * 1000
        : null;

    const newMsg = {
      id: 'm_' + Date.now(),
      convId: activeConversation.id,
      senderCode: currentUser.whisperCode,
      senderAlias: currentUser.alias,
      text: plain,
      cipherText: encryptedPacket.cipherText,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      status: 'read',
      type: 'text',
      replyTo: currentReply ? { alias: currentReply.senderAlias, text: currentReply.text } : null,
      reactions: [],
      expiresAt: expiryTime
    };

    setMessages((prev) => [...prev, newMsg]);

    setConversations((prev) =>
      prev.map((c) => (c.id === activeConversation.id ? { ...c, unreadCount: 0 } : c))
    );

    if (simulateLiveReply) {
      const targetConvId = activeConversation.id;
      const otherParticipantCode = activeConversation.participants.find(
        (code) => code !== currentUser.whisperCode
      );
      const responder = users.find(
        (u) => u.whisperCode === otherParticipantCode && u.status === 'active'
      );

      if (responder) {
        setTypingIndicatorConvId(targetConvId);
        setTimeout(async () => {
          const replyText =
            plain.toLowerCase().includes('call')
              ? 'Sure! Click the Voice or Video icon at the top right of our chat whenever you are ready.'
              : responder.autoReply ||
                `Received your encrypted message ("${plain.slice(0, 28)}..."). Standing by.`;

          const replyCipher = await CryptoEngine.encryptPayload(replyText, targetConvId);
          const replyMsg = {
            id: 'm_reply_' + Date.now(),
            convId: targetConvId,
            senderCode: responder.whisperCode,
            senderAlias: responder.alias,
            text: replyText,
            cipherText: replyCipher.cipherText,
            timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
            status: 'read',
            type: 'text',
            reactions: [],
            expiresAt: expiryTime
          };
          setTypingIndicatorConvId(null);
          setMessages((prev) => [...prev, replyMsg]);
        }, 1600);
      }
    }
  };

  const handleFinishVoiceNote = async () => {
    if (!currentUser || !activeConversation) return;
    const dur = Math.max(1, recordingSeconds);
    setIsRecordingVoice(false);

    const encryptedPacket = await CryptoEngine.encryptPayload(`VOICE_${dur}S`, activeConversation.id);
    const expiryTime =
      activeConversation.disappearingTimer > 0
        ? Date.now() + activeConversation.disappearingTimer * 1000
        : null;

    const newMsg = {
      id: 'm_' + Date.now(),
      convId: activeConversation.id,
      senderCode: currentUser.whisperCode,
      senderAlias: currentUser.alias,
      text: `Voice Message (${dur}s)`,
      cipherText: encryptedPacket.cipherText,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      status: 'read',
      type: 'voice',
      reactions: [],
      expiresAt: expiryTime
    };

    setMessages((prev) => [...prev, newMsg]);
  };

  const handleFileUpload = async (e) => {
