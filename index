    const nextTimer = order[(order.indexOf(activeConversation.disappearingTimer) + 1) % order.length];
    setConversations((prev) =>
      prev.map((c) => (c.id === activeConversation.id ? { ...c, disappearingTimer: nextTimer } : c))
