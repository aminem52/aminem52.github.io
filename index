                    placeholder="e.g. WSP-8821-VORTEX"
                    className="w-full bg-black border border-zinc-800 focus:border-white rounded-xl pl-10 pr-4 py-3 text-sm font-mono tracking-wider text-white placeholder-zinc-600 focus:outline-none transition"
                  />
