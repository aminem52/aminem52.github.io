    setConversations((prev) => [newGroup, ...prev]);
    setActiveConvId(newGroup.id);
    setActiveTab('chats');
    setMobileShowChat(true);
    setShowNewGroupModal(false);
    setNewGroupName('');
    setSelectedGroupMembers([]);
    triggerToast(`Created encrypted group "${newGroup.name}"`);
