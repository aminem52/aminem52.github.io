            <WhisperLogo className="w-9 h-9" />
            <div>
              <span className="font-bold tracking-[0.22em] text-sm uppercase text-white block">
                WHISPER
              </span>
              <span className="text-[10px] text-zinc-400 font-mono">
                Private Client Messenger
              </span>
            </div>
          </div>
          <div className="flex items-center gap-2 text-xs font-mono text-zinc-300 bg-zinc-950 border border-zinc-800 px-3 py-1.5 rounded-full">
            <Lock className="w-3.5 h-3.5 text-white" />
            <span>End-to-End Encrypted</span>
          </div>
        </header>

        <main className="relative z-10 flex-1 flex items-center justify-center p-4">
          <div className="w-full max-w-md bg-[#090909] border border-zinc-800 rounded-3xl shadow-[0_25px_80px_rgba(0,0,0,0.95)] p-7 sm:p-8">
            <div className="flex flex-col items-center text-center mb-6">
              <WhisperLogo className="w-20 h-20 mb-4 shadow-2xl" />
              <h1 className="text-2xl font-bold tracking-tight text-white">
                Welcome to Whisper
              </h1>
              <p className="text-xs text-zinc-400 mt-1.5 max-w-xs leading-relaxed">
                Private, invite-only messenger. Sign in with the{' '}
                <span className="text-white font-medium">Whisper-Code</span> and password provided by your Admin.
              </p>
            </div>

            {loginError && (
              <div className="mb-5 p-3.5 rounded-2xl bg-zinc-950 border border-white/30 flex items-start gap-2.5 text-xs text-zinc-200">
                <ShieldAlert className="w-4 h-4 text-white shrink-0 mt-0.5" />
                <span>{loginError}</span>
              </div>
            )}

            <form onSubmit={handleLogin} className="space-y-4">
